{
  "name": "@tropass/mcp-installer",
  "version": "2.1.1",
  "description": "Installer for configuring agents to use the Tropass remote MCP gateway.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tropass-ai/mcp-installer.git"
  },
  "keywords": [
    "tropass",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "opencode",
    "installer",
    "ml-models"
  ],
  "bin": {
    "tropass-mcp-install": "./dist/bin/tropass-mcp-install.js"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "ink": "^7.1.1",
    "ink-link": "^4.1.0",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "eslint": "^9.39.1",
    "opencode-ai": "^1.17.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/copy-build-assets.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint bin src test scripts --ext .ts,.tsx,.mjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  }
}
